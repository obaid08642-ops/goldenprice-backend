---
import Base from "../layouts/Base.astro";
import "../i18n/load";
import { ASSETS, hasFx, type Asset } from "../data/assets";
import { COUNTRIES, TOP_CURRENCIES, langsFor, type Country } from "../data/countries";
import type { Lang } from "../data/languages";
import { retailFor } from "../data/retail";
import { keywordsFor } from "../data/keywords";
import { t } from "../i18n/ui";
import { countryName, currencyName, fmt } from "../lib/format";
import { getData } from "../lib/api";
import { url, isPrimary, pageExists } from "../lib/paths";
import { assetName, defaultUnit, hasPrice, local, renderBars, renderCurrencies, renderHero, renderMarkets, renderMarketsAll, renderRates, renderSide, renderTicker, renderUsed, unitLabel, type Ctx } from "../lib/render";

interface Props { lang: Lang; country: Country; view: "asset" | "markets" | "rates" | "calc"; asset?: Asset | null }
const { lang, country, view, asset = null } = Astro.props;
const data = await getData();
const retail = retailFor(country.code);
const slug = view === "asset" ? (asset!.slug === "gold" ? "" : asset!.slug) : view === "markets" ? "markets" : view === "rates" ? "rates" : "calculators";
const cn = countryName(lang, country.code);
const ads = import.meta.env.PUBLIC_ADS === "1";
const a = asset ?? ASSETS[0];
const unit = defaultUnit(a);
const c: Ctx = { lang, country, asset: a, unit, data, retail };
const aName = assetName(lang, a);
const uName = unitLabel(lang, unit);
const priceNow = fmt(lang, local(c, a, unit));
const isIdx = a.kind === "index";

const title = view === "asset" ? (isIdx ? t(lang, "title_idx", { a: aName, country: cn }) : t(lang, "title", { a: aName, country: cn, u: uName, cur: country.cur })) : view === "markets" ? t(lang, "list_title", { country: cn }) : view === "rates" ? t(lang, "rates_page_title", { country: cn }) : t(lang, "calc_page_title", { country: cn });
const description = view === "asset" ? (isIdx ? t(lang, "desc_idx", { a: aName }) : t(lang, "desc", { a: aName, country: cn, cur: country.cur })) : view === "markets" ? t(lang, "list_desc", { country: cn, cur: country.cur }) : view === "rates" ? t(lang, "rates_desc", { cur: country.cur }) : t(lang, "calc_page_desc", { cur: country.cur });
const allSlugs = ASSETS.filter((x) => hasPrice(data, x)).map((x) => x.slug);
const primary = isPrimary(lang, country);
// hreflang: this page in the other indexable languages of the same country, plus x-default
const alternates = langsFor(country).map((l) => ({ hreflang: `${l}-${country.code}`, href: url(l, country.code, slug) }));
alternates.push({ hreflang: "x-default", href: url("en", country.code, slug) });
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const faq = view === "asset" && !isIdx ? [
  [t(lang, "q1", { a: aName, country: cn }), t(lang, "a1", { a: aName, country: cn, p: priceNow, cur: country.cur, u: uName })],
  [t(lang, "q2"), t(lang, "a2", { country: cn })],
  [t(lang, "q3"), t(lang, "a3")],
] : [];
const jsonld: unknown[] = [
  { "@context": "https://schema.org", "@type": "WebPage", name: title, description, inLanguage: lang, url: site + url(lang, country.code, slug) },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: cn, item: site + url(lang, country.code) }, ...(slug ? [{ "@type": "ListItem", position: 2, name: title, item: site + url(lang, country.code, slug) }] : [])] },
];
if (faq.length) jsonld.push({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map(([q, ans]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: ans } })) });

const sameKind = ASSETS.filter((x) => (view !== "asset" || x.kind === a.kind) && hasPrice(data, x)).slice(0, 14);
const kw = keywordsFor(lang, country.code);
const related = (view === "asset" ? kw?.[a.slug] : kw?._general)?.slice(0, 10) ?? [];
const links = (kw ? Object.entries(kw).filter(([k]) => k !== "_general") : []).map(([k]) => k);
const kwSearch = view === "asset" ? kw?.[a.slug]?.[0] : undefined;

const boot = JSON.stringify({ retail, lang, cc: country.code, cur: country.cur, view, slug: a.slug, sym: a.sym, unit, tola: !!country.tola, api: import.meta.env.PUBLIC_API_URL || "https://goldenprice-backend.onrender.com",
  ui: { geo_ask: t(lang, "geo_ask", { country: "{country}", cur: "{cur}" }), geo_yes: t(lang, "geo_yes"), geo_no: t(lang, "geo_no"), updated: t(lang, "updated", { t: "{t}" }), conv_result: t(lang, "conv_result", { amount: "{amount}", from: "{from}", value: "{value}", to: "{to}" }), calc_value: t(lang, "calc_value"), zakat_due: t(lang, "zakat_due"), zakat_below: t(lang, "zakat_below") },
  assets: ASSETS.filter((x) => hasPrice(data, x)).map((x) => ({ slug: x.slug, name: assetName(lang, x), en: assetName("en", x) })),
  countries: COUNTRIES.map((x) => { const l = langsFor(x).includes(lang) ? lang : langsFor(x)[0]; return { code: x.code, name: countryName(lang, x.code), cur: x.cur, href: url(l, x.code, pageExists(l, x, slug, allSlugs) ? slug : ""), lang: l }; }),
  currencies: TOP_CURRENCIES.filter((x) => data.rates[x]).map((x) => ({ code: x, name: currencyName(lang, x) })) });
---
<Base lang={lang} country={country} slug={slug} title={title} description={description} alternates={primary ? alternates : []} noindex={!primary} jsonld={jsonld}>
  <main class="m" id="page" data-boot={boot}>
    <div class="geo" id="geo" role="status"><span id="geo-text"></span><button class="y" id="geo-yes" type="button"></button><button id="geo-no" type="button"></button></div>
    <div class="tk" id="ticker" set:html={renderTicker(c)} />
    <form class="sr" id="search" role="search">
      <span aria-hidden="true">🔍</span>
      <input id="q" type="search" autocomplete="off" placeholder={kwSearch ?? t(lang, "search_ph", { country: cn, a: aName })} aria-label={t(lang, "search_btn")} />
      <button type="submit">{t(lang, "search_btn")}</button>
    </form>
    <h1 class="sr-only">{title}</h1>

    {view === "asset" && (
      <div class:list={["top", { solo: isIdx }]}>
        <section class="card hero">
          <div id="hero" set:html={renderHero(c)} />
          <div class="rg" id="ranges">
            <button data-days="1" type="button">{t(lang, "r1d")}</button><button data-days="7" type="button">{t(lang, "r1w")}</button><button data-days="30" class="on" type="button">{t(lang, "r1m")}</button><button data-days="365" type="button">{t(lang, "r1y")}</button><button data-days="1825" type="button">{t(lang, "r5y")}</button><button data-days="3650" type="button">{t(lang, "rall")}</button>
          </div>
          <div id="chart" aria-label={aName}></div>
        </section>
        {!isIdx && <aside class="side" id="side" set:html={renderSide(c)} />}
      </div>
    )}

    {view === "markets" && <div class="stack" id="markets-all" set:html={renderMarketsAll(c)} />}

    {view === "rates" && (
      <>
        <section class="card" id="converter"><h2>{t(lang, "conv_title")}</h2>
          <div class="conv"><label>{t(lang, "conv_amount")}<input id="cv-amount" type="number" inputmode="decimal" value="100" min="0" step="any" /></label>
            <label>{t(lang, "conv_from")}<select id="cv-from">{TOP_CURRENCIES.filter((x) => data.rates[x]).map((x) => <option value={x} selected={x === country.cur}>{x} · {currencyName(lang, x)}</option>)}</select></label>
            <label>{t(lang, "conv_to")}<select id="cv-to">{TOP_CURRENCIES.filter((x) => data.rates[x]).map((x) => <option value={x} selected={x === (country.cur === "USD" ? "EUR" : "USD")}>{x} · {currencyName(lang, x)}</option>)}</select></label></div>
          <div class="conv-out n" id="cv-out"></div></section>
        <section class="card"><h2>{t(lang, "rates_title", { cur: country.cur })}</h2><div class="k">{t(lang, "rates_sub")}</div><div class="tbl" id="rates-table" set:html={renderRates(c)} /></section>
      </>
    )}

    {view === "calc" && (
      <div class="two" id="calc" data-gold={data.items.GOLD?.price ?? ""} data-silver={data.items.SILVER?.price ?? ""} data-rate={data.rates[country.cur] ?? 1}>
        <section class="card"><h2>{t(lang, "calc_title")}</h2>
          <div class="conv"><label>{t(lang, "calc_weight")}<input id="gc-w" type="number" inputmode="decimal" value="10" min="0" step="any" /></label>
            <label>{t(lang, "calc_unit")}<select id="gc-u"><option value="gram">{t(lang, "u_gram")}</option><option value="ounce">{t(lang, "u_ounce")}</option><option value="kilo">{t(lang, "u_kilo")}</option>{country.tola && <option value="tola">{t(lang, "u_tola")}</option>}</select></label>
            <label>{t(lang, "calc_karat")}<select id="gc-k">{ASSETS[0].karats!.map((k) => <option value={k} selected={k === 21}>{k}K</option>)}</select></label></div>
          <div class="conv-out"><span class="k">{t(lang, "calc_value")}</span><div class="big n" id="gc-out"></div></div><div class="k small">{t(lang, "calc_note")}</div></section>
        <section class="card"><h2>{t(lang, "zakat_title")}</h2>
          <div class="conv"><label>{t(lang, "zakat_gold_g")}<input id="zk-g" type="number" inputmode="decimal" value="0" min="0" step="any" /></label>
            <label>{t(lang, "zakat_silver_g")}<input id="zk-s" type="number" inputmode="decimal" value="0" min="0" step="any" /></label></div>
          <div class="row"><span>{t(lang, "zakat_nisab_gold")}</span><b class="n" id="zk-ng"></b></div><div class="row"><span>{t(lang, "zakat_nisab_silver")}</span><b class="n" id="zk-ns"></b></div>
          <div class="conv-out"><span class="k">{t(lang, "zakat_due")}</span><div class="big n" id="zk-out"></div></div><div class="k small">{t(lang, "zakat_note")}</div></section>
      </div>
    )}

    {view !== "calc" && view !== "rates" && (
      <div class="tiles">
        {sameKind.map((x) => <a class:list={["tile", { on: x.slug === a.slug && view === "asset" }]} href={url(lang, country.code, x.slug)}><i>{x.code}</i>{assetName(lang, x)}</a>)}
      </div>
    )}

    {ads && <div class="ad">Ad · 970×90</div>}

    {view === "asset" && (a.sym === "GOLD" || a.sym === "SILVER") && (
      <>
        <div class="stack" id="bars" set:html={renderBars(c)} />
        {a.sym === "GOLD" && <div class="stack" id="used" set:html={renderUsed(c)} />}
      </>
    )}

    {view === "asset" && hasFx(a) && (
      <div class="two">
        <section class="card"><h2>{t(lang, "currencies_title", { a: aName })}</h2><div class="tbl" id="currencies" set:html={renderCurrencies(c)} /></section>
        <section class="card"><h2>{t(lang, "nav_all")}</h2><div class="k">{t(lang, "markets_sub", { cur: country.cur })}</div><div class="tbl" id="markets" set:html={renderMarkets(c)} /></section>
      </div>
    )}

    {related.length > 0 && (
      <section class="card"><h2>{t(lang, "related_title")}</h2>
        <div class="chipsrow">{related.map((r) => <a class="chip2" href={view === "asset" ? url(lang, country.code, slug) : url(lang, country.code)}>{r}</a>)}</div></section>
    )}

    {faq.length > 0 && (
      <section class="card faq"><h2>{t(lang, "faq_title")}</h2>
        {faq.map(([q, ans]) => <details><summary>{q}</summary><p>{ans}</p></details>)}
      </section>
    )}
    {ads && <div class="ad">Ad · 728×90</div>}
  </main>
  <script>
    import "../scripts/live.ts";
  </script>
</Base>
