---
import Base from "../../layouts/Base.astro";
import "../../i18n/load";
import { LANG_CODES } from "../../data/languages";
import { COUNTRIES, langsFor } from "../../data/countries";
import { legalOf, t } from "../../i18n/ui";
import { SITE_NAME } from "../../lib/paths";
export function getStaticPaths() {
  return LANG_CODES.flatMap((lang) => ["about", "privacy", "contact"].map((legal) => ({ params: { lang, legal }, props: { lang, legal } })));
}
const { lang, legal } = Astro.props;
const country = COUNTRIES.find((c) => langsFor(c)[0] === lang) ?? COUNTRIES.find((c) => c.code === "US")!;
const title = t(lang, legal);
const paras = legalOf(lang, legal, SITE_NAME);
---
<Base lang={lang} country={country} slug="" title={`${title} – ${SITE_NAME}`} description={paras[0] ?? title}>
  <main class="m"><section class="card prose"><h1>{title}</h1>{paras.map((p) => <p>{p}</p>)}</section></main>
</Base>
